{
 "uid": "labs-fleet",
 "title": "Labs: fleet and monitoring",
 "tags": [
  "lab",
  "fleet"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "Runs and tests",
    "enable": true,
    "iconColor": "#5794F2",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "srv6-core",
      "run"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Test events (failover, reflector)",
    "enable": true,
    "iconColor": "#F2495C",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "srv6-core",
      "test"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Steering changes",
    "enable": true,
    "iconColor": "#FF9830",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "srv6-core",
      "steering"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Router syslog alerts (vmalert-logs)",
    "enable": true,
    "iconColor": "#B877D9",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "expr": "ALERTS{lab=\"srv6-core\",evaluator=\"vmalert-logs\",alertstate=\"firing\",severity!=\"info\"}",
    "step": "30s",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{hostname}}",
    "tagKeys": "alertname,hostname"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "Exporters up per lab",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum by (lab) (up{job=~\"node|frr|portal\"})",
     "legendFormat": "{{lab}} up"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "count by (lab) (up{job=~\"node|frr|portal\"})",
     "legendFormat": "{{lab}} targets"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "Monitoring stack",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"monitoring\"}",
     "legendFormat": "{{component}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "1": {
         "text": "up",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "title": "CPU busy % by node (all labs)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100 * (1 - avg by (lab, node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
     "legendFormat": "{{lab}} {{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "title": "Memory used % by node (all labs)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
     "legendFormat": "{{lab}} {{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "title": "Tests: passed / failed per lab",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_passed",
     "legendFormat": "{{lab}} passed"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_failed",
     "legendFormat": "{{lab}} failed"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "title": "Firing alerts",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
  {
   "id": 7,
   "title": "Samples scraped / s (Prometheus)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
     "legendFormat": "samples/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "title": "VictoriaMetrics: active series",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "vm_cache_entries{type=\"storage/hour_metric_ids\"}",
     "legendFormat": "active series"
