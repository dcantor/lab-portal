{
 "uid": "evpn-fabric-k8s",
 "title": "EVPN fabric: Kubernetes",
 "tags": [
  "evpn-fabric",
  "lab",
  "kubernetes"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "Runs and tests",
    "enable": true,
    "iconColor": "#5794F2",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "evpn-fabric",
      "run"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Test events (failover, reflector)",
    "enable": true,
    "iconColor": "#F2495C",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "evpn-fabric",
      "test"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Steering changes",
    "enable": true,
    "iconColor": "#FF9830",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "evpn-fabric",
      "steering"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Router syslog alerts (vmalert-logs)",
    "enable": true,
    "iconColor": "#B877D9",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "expr": "ALERTS{lab=\"evpn-fabric\",evaluator=\"vmalert-logs\",alertstate=\"firing\",severity!=\"info\"}",
    "step": "30s",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{hostname}}",
    "tagKeys": "alertname,hostname"
   }
  ]
 },
 "templating": {
  "list": []
 },
