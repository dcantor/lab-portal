  {
   "id": 22,
   "title": "VMs running",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_vm_running{lab=\"homa-lab\"}",
     "legendFormat": "{{node}} ({{role}})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "1": {
         "text": "up",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
