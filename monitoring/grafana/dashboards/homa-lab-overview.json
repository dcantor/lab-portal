  {
   "id": 9,
   "title": "Bit rate towards each host",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "rate(sw1_port_bytes_total{lab=\"homa-lab\"}[2m]) * 8",
     "legendFormat": "\u2192 {{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "title": "Packets/s by priority queue (all ports; 7 = highest)",
