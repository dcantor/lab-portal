      "mode": "columns"
     }
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true
      },
      "renameByName": {
       "Value": "flows"
      },
      "indexByName": {
