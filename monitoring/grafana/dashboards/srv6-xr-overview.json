   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(srv6xr_tenant_reachable{lab=\"srv6-xr\",same_tenant=\"true\"}) + (count(srv6xr_tenant_reachable{lab=\"srv6-xr\",same_tenant=\"false\"} == 0) or vector(0))",
     "legendFormat": "of 16"
    }
   ],
   "fieldConfig": {
    "defaults": {
