    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 6,
   "title": "Last Robot run",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_passed{lab=\"srv6-xr\"}",
     "legendFormat": "passed"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_failed{lab=\"srv6-xr\"}",
     "legendFormat": "failed"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "passed"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none"
   }
  },
