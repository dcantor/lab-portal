      "uid": "victoriametrics"
     },
     "expr": "sum(srv6xr_isis_adjacency_up{lab=\"srv6-xr\"})",
     "legendFormat": "of 12 (6 links x 2 ends)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
