      "uid": "victoriametrics"
     },
     "expr": "lab_isis_adjacencies_expected{lab=\"srv6-core\"}",
     "legendFormat": "{{node}} expected",
     "hide": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
