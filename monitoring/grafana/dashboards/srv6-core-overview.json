      "uid": "victoriametrics"
     },
     "expr": "lab_isis_adjacencies_up{lab=\"srv6-core\"}",
     "legendFormat": "{{node}} up"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_isis_adjacencies_expected{lab=\"srv6-core\"}",
     "legendFormat": "{{node}} expected",
     "hide": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* expected"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          4
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
