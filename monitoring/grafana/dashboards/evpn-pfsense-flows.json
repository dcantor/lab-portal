      "uid": "victorialogs"
     },
     "expr": "lab:evpn-pfsense type:SFLOW_5 entry:true | stats by (pair, tenant, app_proto, app_port) sum(est_bytes) as bytes | sort by (bytes desc) | limit 20",
     "legendFormat": "",
     "queryType": "stats"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "bytes"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true
      },
      "renameByName": {
       "Value": "bytes"
      },
      "indexByName": {
       "pair": 0,
       "tenant": 1,
       "app_proto": 2,
       "app_port": 3,
       "Value": 4
      }
     }
    }
   ]
  },
