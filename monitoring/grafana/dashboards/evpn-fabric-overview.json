    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "count(lab_default_route_paths{lab=\"evpn-fabric\",role=\"leaf\"})",
     "legendFormat": "of"
