    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "title": "Node health (the portal's view)",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_node_health{lab=\"evpn-fabric\"}",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "0.5": {
         "text": "degraded",
         "color": "orange"
        },
        "1": {
         "text": "ok",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
