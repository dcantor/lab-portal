   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "-lab:evpn-clab -lab:srl-evpn -lab:evpn-pfsense hostname:~\"^(spine[0-9]+|leaf[0-9]+|border[0-9]+|fw-ext)$\" (app_name:bgpd \"%ADJCHANGE\") OR (app_name:bfdd \"state-change\") | uniq by (_time, hostname, _msg) | stats by (_time:5m, hostname) count() as events",
     "legendFormat": "{{hostname}}",
     "queryType": "statsRange"
