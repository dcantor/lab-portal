  {
   "id": 19,
   "title": "BGP / BFD events / 5 min per node",
   "type": "timeseries",
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
