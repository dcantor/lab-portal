  {
   "id": 6,
   "title": "Last verify",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_verify_checks_passed{lab=\"evpn-clab\"}",
     "legendFormat": "passed"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_verify_checks_total{lab=\"evpn-clab\"} - lab_verify_checks_passed{lab=\"evpn-clab\"}",
     "legendFormat": "failed"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "passed"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none"
   }
