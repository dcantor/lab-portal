  {
   "id": 9,
   "title": "Offered to eth1 vs lost at its receive ring (host tap)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 8
