{
 "uid": "xdp-lab-overview",
 "title": "xdp-lab: overview (eBPF/XDP vs nftables, kernel, IPVS)",
 "tags": [
  "xdp-lab",
  "lab",
  "xdp",
  "ebpf"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "Runs and tests",
    "enable": true,
    "iconColor": "#5794F2",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "xdp-lab",
      "run"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Test events (failover, reflector)",
    "enable": true,
    "iconColor": "#F2495C",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "xdp-lab",
      "test"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Steering changes",
    "enable": true,
    "iconColor": "#FF9830",
    "datasource": {
     "type": "grafana",
     "uid": "-grafana-"
    },
    "type": "tags",
    "target": {
     "type": "tags",
     "tags": [
      "xdp-lab",
      "steering"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Router syslog alerts (vmalert-logs)",
    "enable": true,
    "iconColor": "#B877D9",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "expr": "ALERTS{lab=\"xdp-lab\",evaluator=\"vmalert-logs\",alertstate=\"firing\",severity!=\"info\"}",
    "step": "30s",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{hostname}}",
    "tagKeys": "alertname,hostname"
   }
  ]
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "The lab",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "VMs running",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(lab_vm_running{lab=\"xdp-lab\"})",
     "legendFormat": "of 4"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "title": "dut mode",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "xdp_lab_mode_info{lab=\"xdp-lab\"}",
     "legendFormat": "{{mode}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "name",
    "colorMode": "none",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "title": "XDP on eth1 (as the kernel reports it)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "count by (prog, attach) (xdp_lab_xdp_attached{lab=\"xdp-lab\",iface=\"eth1\"})",
     "legendFormat": "{{prog}} {{attach}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "nothing attached"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "name",
    "colorMode": "none",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "title": "Sampler on the dut",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "xdp_lab_live_up{lab=\"xdp-lab\"}",
     "legendFormat": "sampler"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "1": {
         "text": "up",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 6,
   "title": "Last Robot run",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_passed{lab=\"xdp-lab\"}",
     "legendFormat": "passed"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_failed{lab=\"xdp-lab\"}",
     "legendFormat": "failed"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "passed"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "title": "Firing alerts",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(ALERTS{lab=\"xdp-lab\",alertstate=\"firing\",severity!=\"info\"}) or vector(0)",
     "legendFormat": "firing"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
