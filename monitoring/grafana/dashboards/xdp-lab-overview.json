    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "xdp_lab_ring_drop_pps{lab=\"xdp-lab\"}",
     "legendFormat": "ring drop (the dut could not keep up)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ring drop (the dut could not keep up)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
