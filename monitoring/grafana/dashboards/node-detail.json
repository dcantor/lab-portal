  {
   "id": 14,
   "title": "BGP peer state (FRR)",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "frr_bgp_peer_state{lab=\"$lab\",node=\"$node\"}",
     "legendFormat": "{{vrf}} {{safi}} {{peer}} (AS {{peer_as}})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "1": {
         "text": "Established",
         "color": "green"
        },
        "2": {
         "text": "admin down",
         "color": "gray"
        }
       }
      }
     ],
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
