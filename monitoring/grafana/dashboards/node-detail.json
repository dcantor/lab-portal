  {
   "id": 17,
   "title": "BGP messages / min per peer",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 35,
    "w": 12,
    "h": 7
