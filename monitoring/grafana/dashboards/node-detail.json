  {
   "id": 16,
   "title": "BGP prefixes received per peer",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
