      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_passed{lab=\"cat8000v-ipsec\"}",
     "legendFormat": "passed"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "lab_tests_last_failed{lab=\"cat8000v-ipsec\"}",
     "legendFormat": "failed"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "thresholds",
