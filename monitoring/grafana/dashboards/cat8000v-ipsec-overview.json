        "id": "thresholds",
        "value": {
         "steps": [
          {
           "color": "green",
           "value": null
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none"
