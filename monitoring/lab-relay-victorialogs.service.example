[Unit]
Description=Relay victorialogs (lab NMS 10.0.0.10:9428) to the LAN on port 9428, behind the Lab Hub's sign-in (labportal/proxy.py)
After=network-online.target

[Service]
ExecStart=/home/dcantor/lab-portal/.venv/bin/lab-proxy --bind 192.168.50.231 --port 9428 --upstream http://10.0.0.10:9428
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
